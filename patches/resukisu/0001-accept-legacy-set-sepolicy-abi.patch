+
+int handle_sepolicy(void __user *user_data, u64 data_len)
+{
+    u8 *payload;
+    int ret;
+
+    if (!user_data || !data_len)
+        return -EINVAL;
+
+    if (data_len > KSU_SEPOLICY_MAX_BATCH_SIZE)
+        return -E2BIG;
+
+    payload = vmalloc((size_t)data_len);
+    if (!payload)
+        return -ENOMEM;
+
+    if (copy_from_user(payload, user_data, (size_t)data_len)) {
+        ret = -EFAULT;
+        goto out_free;
+    }
+
+    ret = ksu_apply_sepolicy_batch(payload, (size_t)data_len);
+
 out_free:
     vfree(payload);
+    return ret;
+}
+
+// Legacy SET_SEPOLICY ABI used by ksud <= v3.1.x: one command per ioctl,
+// arg points to { u32 cmd; u32 subcmd; const char *sepol1..7; }, and a NULL
+// string means ALL. It is converted to a one-command batch so both formats
+// share the same parser and locking.
+#define KSU_SEPOLICY_LEGACY_ARGS 7
+#define KSU_SEPOLICY_LEGACY_MAX_LEN 256
+
+struct sepol_legacy_data {
+    u32 cmd;
+    u32 subcmd;
+    u64 sepol[KSU_SEPOLICY_LEGACY_ARGS];
+};
+
+int handle_sepolicy_legacy(void __user *arg)
+{
+    struct sepol_legacy_data data;
+    struct sepol_data header;
+    char *strs;
+    u32 lens[KSU_SEPOLICY_MAX_ARGS] = { 0 };
+    size_t total;
+    u8 *payload, *p;
+    int argc, i, ret;
+
+    if (!arg)
+        return -EINVAL;
+
+    if (copy_from_user(&data, arg, sizeof(data)))
+        return -EFAULT;
 
+    argc = sepol_expected_argc(data.cmd);
+    if (argc < 0 || argc > KSU_SEPOLICY_MAX_ARGS) {
+        pr_err("sepol: legacy: invalid cmd %u.\n", data.cmd);
+        return -EINVAL;
+    }
+
+    strs = kzalloc(KSU_SEPOLICY_MAX_ARGS * KSU_SEPOLICY_LEGACY_MAX_LEN,
+                   GFP_KERNEL);
+    if (!strs)
+        return -ENOMEM;
+
+    total = sizeof(header);
+    for (i = 0; i < argc; i++) {
+        char *buf = strs + i * KSU_SEPOLICY_LEGACY_MAX_LEN;
+        long n;
+
+        if (data.sepol[i]) {
+            n = strncpy_from_user(buf, (const char __user *)data.sepol[i],
+                                  KSU_SEPOLICY_LEGACY_MAX_LEN);
+            if (n < 0) {
+                ret = -EFAULT;
+                goto out_strs;
+            }
+            if (n >= KSU_SEPOLICY_LEGACY_MAX_LEN) {
+                ret = -ENAMETOOLONG;
+                goto out_strs;
+            }
+            lens[i] = (u32)n;
+        }
+        // NULL (ALL) is encoded as len 0, same as the batch format
+        total += sizeof(u32) + lens[i] + 1;
+    }
+
+    payload = kzalloc(total, GFP_KERNEL);
+    if (!payload) {
+        ret = -ENOMEM;
+        goto out_strs;
+    }
+
+    header.cmd = data.cmd;
+    header.subcmd = data.subcmd;
+    p = payload;
+    memcpy(p, &header, sizeof(header));
+    p += sizeof(header);
+    for (i = 0; i < argc; i++) {
+        memcpy(p, &lens[i], sizeof(u32));
+        p += sizeof(u32);
+        memcpy(p, strs + i * KSU_SEPOLICY_LEGACY_MAX_LEN, lens[i]);
+        p += lens[i] + 1; // trailing '\0' comes from kzalloc
+    }
+
+    ret = ksu_apply_sepolicy_batch(payload, total);
+    if (ret >= 0)
+        ret = ret == 1 ? 0 : -EINVAL;
+
+    kfree(payload);
+out_strs:
+    kfree(strs);
     return ret;
-}
\ No newline at end of file
